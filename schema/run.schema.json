{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "experimentId": {
      "type": "string"
    },
    "app": {
      "type": "string"
    },
    "variant": {
      "type": "string",
      "enum": [
        "base",
        "pr"
      ]
    },
    "url": {
      "type": "string"
    },
    "inject": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "size": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "size"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "sequential",
        "abab"
      ]
    },
    "throttling": {
      "type": "string",
      "enum": [
        "simulate",
        "devtools",
        "none"
      ]
    },
    "runIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "metrics": {
      "type": "object",
      "properties": {
        "lcp": {
          "type": [
            "number",
            "null"
          ]
        },
        "fcp": {
          "type": [
            "number",
            "null"
          ]
        },
        "tbt": {
          "type": [
            "number",
            "null"
          ]
        },
        "cls": {
          "type": [
            "number",
            "null"
          ]
        },
        "si": {
          "type": [
            "number",
            "null"
          ]
        },
        "ttfb": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "lcp",
        "fcp",
        "tbt",
        "cls",
        "si",
        "ttfb"
      ],
      "additionalProperties": false
    },
    "benchmarkIndex": {
      "type": [
        "number",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "env": {
      "type": "object",
      "properties": {
        "chromeVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "lighthouseVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "nodeVersion": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "osRelease": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "cpuModel": {
          "type": "string"
        },
        "cpuCount": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "totalMemMb": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ci": {
          "type": "boolean"
        },
        "runnerImage": {
          "type": [
            "string",
            "null"
          ]
        },
        "runnerName": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "chromeVersion",
        "lighthouseVersion",
        "nodeVersion",
        "platform",
        "osRelease",
        "arch",
        "cpuModel",
        "cpuCount",
        "totalMemMb",
        "ci",
        "runnerImage",
        "runnerName"
      ],
      "additionalProperties": false
    },
    "gitSha": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schemaVersion",
    "experimentId",
    "app",
    "variant",
    "url",
    "inject",
    "mode",
    "throttling",
    "runIndex",
    "order",
    "metrics",
    "benchmarkIndex",
    "error",
    "env",
    "gitSha",
    "timestamp"
  ],
  "additionalProperties": false
}
