{
  "name": "perfgate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "perfgate": "tsx packages/collector/src/cli.ts",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "schema": "tsx packages/collector/src/export-schema.ts",
